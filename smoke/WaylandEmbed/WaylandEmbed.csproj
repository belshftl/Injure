<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/Injure/Injure.csproj" />
	</ItemGroup>

	<!-- needs a C compiler and libwayland-dev -->
	<Target
		Name="BuildWaylandShim"
		AfterTargets="Build"
		Condition="$([MSBuild]::IsOSPlatform('Linux'))"
		Inputs="native/wlembed.c"
		Outputs="$(OutDir)libwlembed.so"
	>
		<Exec Command="cc -std=c11 -O2 -Wall -Wextra -fPIC -shared -fvisibility=hidden `pkg-config --cflags wayland-client` -o &quot;$(OutDir)libwlembed.so&quot; native/wlembed.c `pkg-config --libs wayland-client`" />
	</Target>
</Project>
