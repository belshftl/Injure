<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<DevelopmentDependency>true</DevelopmentDependency>
		<NoPackageAnalysis>true</NoPackageAnalysis>

		<PackageId>Injure.Analyzers</PackageId>
		<Description>WIP game framework/engine with first-class mod support - Roslyn analyzer</Description>
	</PropertyGroup>

	<Import Project="$(MSBuildThisFileDirectory)../../eng/Analyzers/Injure.AnalyzerShared/Injure.AnalyzerShared.props" />

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
		<PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/" />
		<None Include="build/Injure.Analyzers.props" Pack="true" PackagePath="build/" />
	</ItemGroup>
</Project>
