<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsAotCompatible>true</IsAotCompatible>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
		<VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>

		<NoWarn>$(NoWarn);CS1591</NoWarn> <!-- temporary, disable warnings for undocumented public members -->

		<PackageId>Injure</PackageId>
		<Description>the game framework/engine colloquially known as Injure</Description>
	</PropertyGroup>

	<!-- ====================================================================================== -->
	<!-- references/IVT to other Injure packages -->
	<ItemGroup>
		<!-- Injure internals: -->
		<ProjectReference Include="../../eng/Analyzers/Injure.DevAnalyzers/Injure.DevAnalyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<InternalsVisibleTo Include="Injure.Mods.Abstractions.Tests" />
		<InternalsVisibleTo Include="Injure.Tests" />

		<!-- public packages: -->
		<InternalsVisibleTo Include="Injure.Mods.Abstractions" />
		<InternalsVisibleTo Include="Injure.Mods.Runtime" />
	</ItemGroup>

	<!-- ====================================================================================== -->
	<!-- deps -->
	<ItemGroup>
		<!-- general deps -->
		<PackageReference Include="System.IO.Hashing" Version="10.0.5" />
		<PackageReference Include="Hexa.NET.SDL3" Version="1.2.17" />

		<!-- rendering -->
		<PackageReference Include="Alimer.Bindings.WebGPU" Version="1.6.0" />
		<PackageReference Include="Alimer.WebGPU.Native" Version="1.0.4" />

		<!-- asset decoding -->
		<PackageReference Include="StbImageSharp" Version="2.30.15" />

		<!-- text -->
		<PackageReference Include="FreeTypeSharp" Version="3.1.0" />
		<PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
		<PackageReference Include="FriBidiNative" Version="1.0.10" />
	</ItemGroup>

	<!-- ====================================================================================== -->
	<!-- native lib packing -->
	<ItemGroup>
		<None Include="../../native/pack/osx-arm64/libinjureaudio.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
		<None Include="../../native/pack/linux-x64/libinjureaudio.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
		<None Include="../../native/pack/linux-arm64/libinjureaudio.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />

		<None Include="../../native/pack/osx-arm64/libinjuremisc.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
		<None Include="../../native/pack/linux-x64/libinjuremisc.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
		<None Include="../../native/pack/linux-arm64/libinjuremisc.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
	</ItemGroup>

	<!-- ====================================================================================== -->
	<!-- embedded resources -->
	<ItemGroup>
		<EmbeddedResource Include="Rendering/Shaders/primitive2d.wgsl">
			<LogicalName>shaders/primitive2d.wgsl</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Rendering/Shaders/textured2dColor.wgsl">
			<LogicalName>shaders/textured2dColor.wgsl</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Rendering/Shaders/textured2dRMask.wgsl">
			<LogicalName>shaders/textured2dRMask.wgsl</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Rendering/Shaders/textured2dSDF.wgsl">
			<LogicalName>shaders/textured2dSDF.wgsl</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
</Project>
